# Copy to .env and fill in. Never commit .env or the service account file.

# Printed by `trackwatch-push toggl subscribe <url>`.
TOGGL_WEBHOOK_SECRET=

# Any long random string (`trackwatch-push secret`); enter the same one in the phone app.
TRACKWATCH_APP_SECRET=

# Optional: only needed when the service account file has no project_id.
# FIREBASE_PROJECT_ID=
