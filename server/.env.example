# Copy to .env if you want to change anything; the server runs without it. Never commit .env or
# the service account file.

# Optional: only needed when the service account file has no project_id.
# FIREBASE_PROJECT_ID=

# Limits for a public server: phones in all, and new registrations per IP address per hour.
# TRACKWATCH_MAX_REGISTRATIONS=1000
# TRACKWATCH_REGISTRATIONS_PER_IP_HOUR=10

# Host port the container is published on (127.0.0.1 only); default 8081.
# TRACKWATCH_PORT=8081
